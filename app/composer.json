{
    "name": "eshcol/ats",
    "description": "Eshcol Global recruitment tracking app",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-fileinfo": "*",
        "ext-mbstring": "*",
        "ext-pdo_mysql": "*",
        "ext-zip": "*",
        "anthropic-ai/sdk": "^1.6",
        "bacon/bacon-qr-code": "^3.0",
        "dompdf/dompdf": "^3.1",
        "guzzlehttp/guzzle": "^7",
        "smalot/pdfparser": "^2.11"
    },
    "autoload": {
        "psr-4": {
            "Eshcol\\Ats\\": "src/"
        },
        "files": ["src/helpers.php"]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.5.12"
        }
    }
}
