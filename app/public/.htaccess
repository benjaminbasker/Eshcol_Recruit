# Eshcol Recruit - web rules for the app.eshcolglobal.com document root.
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Never serve hidden files (.user.ini, .htaccess and the like)
  RewriteRule (^|/)\. - [F,L]
  # Everything that is not a real file goes to the app
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set Strict-Transport-Security "max-age=15552000"
  Header always set X-Content-Type-Options "nosniff"
</IfModule>

# CSS and JS carry ?v= in their links, so they can be cached for a week.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 30 days"
</IfModule>
AddType font/woff2 .woff2
